{
  "redirects": [
    {
      "source": "/chesstrainer/app",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/chesstrainer/app/",
      "destination": "/app",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/discover",
      "destination": "/discover.html"
    }
  ]
}
